# Copia este archivo a ".env" y pegá los valores reales que te da Vercel
# (Project Settings > Storage > tu base Postgres > .env.local / Connection strings).
#
# DATABASE_URL: cadena de conexión "pooled" (para la app en funcionamiento).
# DATABASE_URL_UNPOOLED: cadena de conexión directa (para migraciones de Prisma).
# Si Vercel te muestra otros nombres (POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, etc.)
# copiá igual esos VALORES en estas dos variables.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# SHAREPOINT_WEBHOOK_SECRET: clave que el flujo de Power Automate debe mandar
# (como ?token=... o en el header "x-webhook-token") para poder llamar a
# /api/sharepoint-sync. Elegí cualquier texto largo y al azar.
SHAREPOINT_WEBHOOK_SECRET="pega-aca-una-clave-larga-y-al-azar"
